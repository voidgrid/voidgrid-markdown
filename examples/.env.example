# Copy to .env next to compose.yaml. Every value is optional; these are the defaults.

# Image tag: a fixed version such as v0.1.0, or "beta" to follow every release, "latest" for stable ones.
VGM_IMAGE_TAG=beta

# Address the published port binds to on the host. Keep 127.0.0.1 when a reverse proxy runs on the same
# host. Use 0.0.0.0 only when the port is reachable by the proxy alone (firewall, private network):
# the app has no authentication.
VGM_BIND=127.0.0.1

# Host port that maps to the app's port 8793.
VGM_PORT=8793

# Time zone for the container's logs.
TZ=Etc/UTC
